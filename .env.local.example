# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=

# App encryption - used to encrypt user API keys at rest
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Optional, while rotating APP_ENCRYPTION_KEY: the old key, so keys saved with
# it still decrypt (each is re-encrypted with the new key on its next save).
# APP_ENCRYPTION_KEY_PREVIOUS=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional - everything below is read by the code but has a sensible default.
# ---------------------------------------------------------------------------

# Operator-paid fallback keys, used only when a user has not set their own key
# in Settings. Anything set here is billed to YOUR account.
# FALLBACK_ANTHROPIC_KEY=
# FALLBACK_GEMINI_KEY=
# FALLBACK_APIFY_TOKEN=
# FALLBACK_ADZUNA_APP_ID=
# FALLBACK_ADZUNA_APP_KEY=
# FALLBACK_RAPIDAPI_KEY=

# Usage limits (lib/usage-limits.ts). Daily quotas apply per user, only when a
# FALLBACK_* key would pay for the call; reset at 00:00 UTC. 0 disables a limit.
# MAX_CONCURRENT_SEARCHES applies to every user.
# QUOTA_SEARCHES_PER_DAY=5
# QUOTA_AI_GENERATIONS_PER_DAY=30
# QUOTA_CV_UPLOADS_PER_DAY=5
# MAX_CONCURRENT_SEARCHES=1

# AI model overrides
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_SMART_MODEL=claude-sonnet-4-6
# GEMINI_FAST_MODEL=gemini-2.5-flash
# GEMINI_SMART_MODEL=gemini-2.5-flash

# Agentic search (Claude + Apify MCP)
# AGENT_ENABLED=true
# AGENT_MODEL=claude-sonnet-4-6
# AGENT_MAX_TOKENS=16000
# AGENTIC_TIMEOUT_MS=210000
# APIFY_MCP_URL=https://mcp.apify.com

# Apify actor overrides
# APIFY_LINKEDIN_ACTOR=bebity/linkedin-jobs-scraper
# APIFY_INDEED_ACTOR=misceres/indeed-scraper
# APIFY_GLASSDOOR_ACTOR=bebity/glassdoor-jobs-scraper

# Browser extension - comma-separated extension origins allowed to read
# /api/me/application-profile via CORS. Usually not needed (the extension's
# host permissions exempt it from CORS). Example: chrome-extension://abcdef...
# ALLOWED_EXTENSION_ORIGINS=

# Logging - ship structured logs to Axiom (stdout only when unset)
# AXIOM_TOKEN=
# AXIOM_DATASET=
